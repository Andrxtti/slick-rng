// Build one cast member in Daz Studio from a spec file, render review shots, and (optionally) send it to Unity.
// Run through the PC worker like the probes: job json { "script": "build_char.dsa", "secs": 2400, "args": { "spec": "chars/slick.json" } }
// The spec (paths relative to the Genesis 9 content folder, People/Genesis 9/):
//   name      file stem for renders and the Unity asset
//   preset    (avoid: character presets open a dialog that hangs headless; use chars)
//   chars     { "Matt": 0.6, "Fabrice": 0.4 } face/body blend of the Base Characters 9 controls, set by value
//   morphs    { morphName: value } set on the figure after the preset (Base Masculine, proportions, character blends)
//   skin      a skin MAT preset applied to the figure, or null to keep the preset's
//   mats      further material presets on the figure (e.g. a character's Eyes MAT for eye colour)
//   wear      [ { file, mat, morphs } ] hair, beard, clothes; each fitted to the figure, then its material preset
//   shots     ["front", "34", "body"] review renders -> renders/<name>_<shot>.png
//   export    false, or { root, folder, filename, morphs[] } -> the Daz to Unity bridge, non-interactive
var DIR = new DzFileInfo(getScriptFileName()).path();
function readText(p) { var f = new DzFile(p); if (!f.exists()) return ""; f.open(DzFile.ReadOnly); var t = f.read(); f.close(); return t; }
var CFG = JSON.parse(readText(DIR + "/run.cfg.json"));
var LOG = [];
function log(s) { LOG.push(String(s)); var f = new DzFile(CFG.log); f.open(DzFile.WriteOnly | DzFile.Truncate); f.write(LOG.join("\n")); f.close(); }
function finish() { var f = new DzFile(CFG.done); f.open(DzFile.WriteOnly); f.write("done"); f.close(); }

var LIB = "C:/Users/Public/Documents/My DAZ 3D Library/People/Genesis 9/";
var cm = App.getContentMgr(), rm = App.getRenderMgr();

function nodeSet() { var s = {}; for (var i = 0; i < Scene.getNumNodes(); i++) s[Scene.getNode(i).name] = Scene.getNode(i); return s; }
function newNodes(before) { var out = [], now = nodeSet(); for (var k in now) if (!before[k]) out.push(now[k]); return out; }
function rootFigures() { var out = []; for (var i = 0; i < Scene.getNumNodes(); i++) { var n = Scene.getNode(i); if (n.inherits("DzFigure") && !n.getNodeParent()) out.push(n); } return out; }
function selectOnly(n) { Scene.selectAllNodes(false); n.select(true); Scene.setPrimarySelection(n); }
function open(path, merge) { var full = LIB + path; if (!new DzFile(full).exists()) { log("  MISSING " + path); return false; } var ok = cm.openFile(full, merge); if (!ok) log("  open failed " + path); return ok; }
function setMorphs(node, morphs) {
  var obj = node.getObject(), n = 0;
  for (var name in morphs) {
    var mod = obj ? obj.findModifier(name) : null;
    if (!mod || !mod.getValueControl()) { log("  no morph " + name + " on " + node.getLabel()); continue; }
    mod.getValueControl().setValue(morphs[name]); n++;
  }
  return n;
}
function propByLabel(el, label) {
  var p = el.findProperty ? el.findProperty(label) : null; if (p) return p;
  for (var i = 0; i < el.getNumProperties(); i++) if (el.getProperty(i).getLabel() == label) return el.getProperty(i);
  return null;
}
function setupRenderer(maxSecs) {
  var r = rm.findRenderer("DzIrayRenderer"); if (r) rm.setActiveRenderer(r);
  var els = rm.getRenderElementObjects ? rm.getRenderElementObjects() : [];
  for (var e = 0; e < els.length; e++) {
    var el = els[e]; if (!el || !el.getNumProperties) continue;
    var ms = propByLabel(el, "Max Samples"), mt = propByLabel(el, "Max Time (secs)");
    if (ms) ms.setValue(600); if (mt) mt.setValue(maxSecs);
  }
}
var CAM = null;
function camera(focal) {
  if (!CAM) { CAM = new DzBasicCamera(); CAM.setName("cfCam"); CAM.setLabel("cfCam"); Scene.addNode(CAM); }
  var fl = propByLabel(CAM, "Focal Length"); if (fl) fl.setValue(focal);
  return CAM;
}
function render(fig, file, kind) {
  var head = fig.findBone("head"), bb = fig.getWSBoundingBox(), p = head ? head.getWSPos() : new DzVec3(0, bb.max.y - 15, 0);
  var cam, at, from;
  if (kind == "body") { cam = camera(50); var mid = (bb.max.y + bb.min.y) / 2; at = new DzVec3(0, mid, 0); from = new DzVec3(0, mid + 10, 430); }
  else {
    cam = camera(85); var a = (kind == "34" ? 35 : 0) * Math.PI / 180, d = 110;
    // the head joint sits ~3 cm below the nose (measured on probe 3); aim just under it so the eyes land on the upper third
    at = new DzVec3(p.x, p.y + 1, p.z + 3); from = new DzVec3(p.x + d * Math.sin(a), p.y + 3, p.z + 3 + d * Math.cos(a));
  }
  cam.setWSPos(from); cam.aimAt(at);
  MainWindow.getViewportMgr().getActiveViewport().get3DViewport().setCamera(cam);
  var ro = rm.getRenderOptions();
  ro.renderImgToId = DzRenderOptions.DirectToFile; ro.renderImgFilename = file;
  ro.isAspectConstrained = false; ro.imageSize = kind == "body" ? new Size(600, 1000) : new Size(640, 800);
  var t0 = new Date().getTime(); var ok = rm.doRender(ro);
  log("  render " + kind + " ok=" + ok + " exists=" + new DzFile(file).exists() + " " + Math.round((new Date().getTime() - t0) / 1000) + "s");
}
// Character faces/bodies by value: a shaping preset written on the fly loads each Base Characters 9 control and sets
// it (e.g. { "Matt": 0.6, "Fabrice": 0.4 }). Character presets themselves open an "apply to selected?" dialog that hangs
// a headless run; shape presets apply silently.
function applyCharacters(fig, blend) {
  var mods = [], anims = [], n = 0;
  for (var nm in blend) {
    var id = nm + "_figure_ctrl_Character"; n++;
    mods.push({ id: id, url: "/data/Daz%203D/Genesis%209/Base/Morphs/Daz%203D/Base%20Characters%209/" + id + ".dsf#" + id });
    anims.push({ url: "name://@selection#" + id + ":?value/value", keys: [[0, blend[nm]]] });
  }
  if (!n) return;
  var duf = { file_version: "0.6.0.0", asset_info: { id: "/cf_shape.duf", type: "preset_shape", contributor: { author: "Confirmed Fire" } }, scene: { modifiers: mods, animations: anims } };
  var path = DIR + "/cf_shape.duf", f = new DzFile(path); f.open(DzFile.WriteOnly | DzFile.Truncate); f.write(JSON.stringify(duf)); f.close();
  selectOnly(fig); var ok = cm.openFile(path, true);
  var obj = fig.getObject(), seen = [];
  for (var m = 0; obj && m < obj.getNumModifiers(); m++) { var md = obj.getModifier(m); for (var nm2 in blend) if (md.name.indexOf(nm2 + "_") == 0) { var vc = md.getValueControl ? md.getValueControl() : null; seen.push(md.name + "=" + (vc ? vc.getValue().toFixed(2) : "?")); } }
  log("  characters " + JSON.stringify(blend) + " ok=" + ok + " loaded: " + (seen.join(", ") || "none found by name"));
}
function exportUnity(fig, ex) {
  var ua = MainWindow.getActionMgr().findAction("DzUnityAction");
  if (!ua) { log("  Daz to Unity bridge not found"); return; }
  selectOnly(fig);
  if (ua.resetToDefaults) ua.resetToDefaults();
  ua.nNonInteractiveMode = 1;
  ua.sAssetType = "SkeletalMesh";
  ua.sRootFolder = ex.root;
  ua.sExportFolder = ex.folder;
  ua.sExportFilename = ex.filename;
  if (ex.morphs && ex.morphs.length) ua.aMorphList = ex.morphs;
  if (ex.install !== undefined) ua.InstallUnityFiles = ex.install;
  var t0 = new Date().getTime(); ua.executeAction();
  log("  exported to " + ex.root + "/" + ex.folder + " (" + Math.round((new Date().getTime() - t0) / 1000) + "s); fbx exists=" + new DzFile(ex.root + "/" + ex.folder + "/" + ex.filename + ".fbx").exists());
}

try {
  log("Daz Studio " + App.versionString);
  var SPEC = JSON.parse(readText(DIR + "/" + CFG.args.spec));
  log("building " + SPEC.name);
  Scene.clear(); log("  scene cleared");
  open("Genesis 9.duf", true);   // clear() then merge: merge=false asks "save changes?" on a modified scene and hangs headless
  var fig = rootFigures()[0]; if (!fig) throw "Genesis 9 did not load";
  selectOnly(fig);
  if (SPEC.preset) {
    open(SPEC.preset, true);
    var figs = rootFigures();
    if (figs.length > 1) { Scene.removeNode(fig); fig = rootFigures()[0]; }   // a preset that brought its own figure
    selectOnly(fig); log("  preset " + SPEC.preset);
  }
  if (SPEC.chars) applyCharacters(fig, SPEC.chars);
  log("  morphs set: " + setMorphs(fig, SPEC.morphs || {}));
  if (SPEC.skin) { selectOnly(fig); open(SPEC.skin, true); log("  skin " + SPEC.skin); }
  var mats = SPEC.mats || [];
  for (var mi = 0; mi < mats.length; mi++) { selectOnly(fig); open(mats[mi], true); log("  mat " + mats[mi]); }
  var wear = SPEC.wear || [];
  for (var w = 0; w < wear.length; w++) {
    selectOnly(fig); var before = nodeSet();
    if (!open(wear[w].file, true)) continue;
    var added = newNodes(before), item = null;
    for (var a = 0; a < added.length; a++) if (added[a].inherits("DzFigure") || added[a].getObject()) { item = added[a]; break; }
    log("  wear " + wear[w].file + " -> " + (item ? item.getLabel() : "nothing new"));
    if (!item) continue;
    var io = item.getObject(), dials = [];   // the item's own shaping dials (length, volume...), for the next spec
    for (var m = 0; io && m < io.getNumModifiers(); m++) { var md = io.getModifier(m), vc = md.getValueControl ? md.getValueControl() : null; if (vc && md.inherits("DzMorph") && vc.getPath().indexOf("/Hidden") != 0) dials.push(md.name + "=" + vc.getValue().toFixed(2)); }
    log("    dials: " + dials.slice(0, 60).join(", "));
    if (wear[w].morphs) log("    morphs set: " + setMorphs(item, wear[w].morphs));
    if (wear[w].mat) { selectOnly(item); open(wear[w].mat, true); log("    mat " + wear[w].mat); }
  }
  selectOnly(fig);
  var bb = fig.getWSBoundingBox(); log("  height " + Math.round(bb.max.y - bb.min.y) + " cm");
  new DzDir(DIR).mkdir("renders");
  setupRenderer(SPEC.renderSecs || 90);
  var shots = SPEC.shots || ["front", "34", "body"];
  for (var s = 0; s < shots.length; s++) render(fig, DIR + "/renders/" + SPEC.name + "_" + shots[s] + ".png", shots[s]);
  if (SPEC["export"]) exportUnity(fig, SPEC["export"]);   // "export" is reserved in Daz Script (ES3): no dot access
} catch (e) { log("ERROR " + e + (e.lineNumber ? " line " + e.lineNumber : "")); }
finish();
